# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
scripts/.cache/

# Import pipeline working files
scripts/.cache/
data/security-master.json

# Ephemeral run pointer. Never committed: a pointer inherited from checkout
# could otherwise let a crashed run attach a previous run's evidence to itself.
data/import-runs/latest-run-id.txt

# One-off analysis scratch, never committed
scripts/.probe/
